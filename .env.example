# === TrendBot API Keys ===
# At least one search provider key is required for discovery.
# LLM keys are required for concept generation and lyric writing.

# Search Providers (at least one recommended)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SERPAPI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# YouTube Data API v3 (for video metadata + transcripts)
YOUTUBE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM Providers (at least one required)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Reddit API (for reddit provider)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional: GitHub token (for trending repos)
GITHUB_TOKEN=

# === Configuration ===
# Default LLM provider: "anthropic" or "openai"
TRENDBOT_LLM_PROVIDER=anthropic

# SQLite database path (default: ./trendbot.db)
TRENDBOT_DB_PATH=./trendbot.db

# Log level: DEBUG, INFO, WARNING, ERROR
TRENDBOT_LOG_LEVEL=INFO
